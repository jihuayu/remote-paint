FROM node:22-bookworm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libnss3 libglib2.0-0 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libx11-6 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
    libxkbcommon0 libdrm2 libgbm1 libpango-1.0-0 libasound2 libatspi2.0-0 \
    libudev1 libcups2 fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
ENV REMOTE_PAINT_CHROMIUM=/browser/headless_shell
WORKDIR /project
CMD ["node", "live.mjs", "--host", "0.0.0.0", "--port", "4176"]
