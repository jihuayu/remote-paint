import("//testing/test.gni")

source_set("serializer") {
  sources = [ "serializer.cc", "serializer.h", "canvas_capture.cc", "canvas_capture.h", "recording_index.cc", "recording_index.h", "asset_cache.h", "font_subset.cc", "font_subset.h" ]
  defines = [ "REMOTE_PAINT_CHROMIUM" ]
  deps = [ "//base", "//skia", "//third_party/harfbuzz" ]
}

source_set("capture_hosts") {
  sources = [ "capture_host_registry.h", "encoded_picture.h" ]
  public_deps = [ ":serializer" ]
}

source_set("subscription_state") {
  sources = [ "subscription_state.h", "subscription_credit.h" ]
}

source_set("capture") {
  sources = [ "capture_state.cc", "capture_state.h" ]
  public_deps = [ ":capture_hosts", ":subscription_state" ]
  deps = [ ":serializer", ":viz_delivery", "//base", "//crypto", "//skia" ]
}

source_set("viz_delivery") {
  public_deps = [ ":subscription_state" ]
  sources = [ "viz_delivery.cc", "viz_delivery.h", "capture_frame_marker.cc", "capture_frame_marker.h" ]
  deps = [ "//base" ]
}

test("serializer_tests") {
  sources = [ "serializer_unittest.cc", "test_main.cc",
    "//base/test/test_discardable_memory_allocator.cc",
    "//base/test/test_discardable_memory_allocator.h" ]
  deps = [
    ":serializer",
    ":viz_delivery",
    ":capture_hosts",
    ":subscription_state",
    "//base",
    "//skia",
    "//testing/gtest",
  ]
}

# Actual upstream BaseFile and native pre-write filesystem contracts only.
# Keep this independent of the headless_shell output and its retained graph.
test("download_file_tests") {
  sources = [
    "download_file_test_main.cc",
    "download_file_unittest.cc",
    "download_file_deletion_unittest.cc",
    "download_task_settlement_unittest.cc",
    "download_request_owner_unittest.cc",
    "download_admission_unittest.cc",
    "//components/download/internal/common/base_file_unittest.cc",
  ]
  deps = [
    ":download_regression_tests",
    "//base",
    "//base/test:test_support",
    "//components/download/public/common:public",
    "//components/download/internal/common:internal",
    "//components/download/public/common:test_support",
    "//mojo/core/embedder",
    "//testing/gmock",
    "//crypto",
    "//net",
    "//testing/gtest",
    "//url",
  ]
}

# Upstream and local download_file_unittest.cc must use separate object paths.
source_set("download_regression_tests") {
  testonly = true
  sources = [
    "//components/download/internal/common/download_file_unittest.cc",
    "//components/download/internal/common/download_item_impl_unittest.cc",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//components/download/public/common:public",
    "//components/download/public/common:test_support",
    "//crypto",
    "//mojo/core/embedder",
    "//net",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
