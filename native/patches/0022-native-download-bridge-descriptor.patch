 }
 
 PageHandler::~PageHandler() = default;
+
+Response PageHandler::GetRemotePaintDownloadBridge(
+    const std::string& token,
+    const std::string& document_token,
+    int* descriptor_version,
+    bool* transfers_ready,
+    std::string* current_document_token,
+    int* max_items,
+    int* max_file_bytes) {
+  // These are browser-owned witnesses, never caller-provided frame/trust IDs.
+  const bool active_top_frame = AssureTopLevelActiveFrame().IsSuccess();
+  const std::string actual_document = active_top_frame
+      ? host_->GetDocumentToken().ToString() : std::string();
+  const auto descriptor = remote_paint_download_bridge_.Describe(
+      token, document_token, actual_document, is_trusted_, active_top_frame);
+  if (!descriptor)
+    return Response::ServerError("Remote Paint download bridge unavailable");
+  *descriptor_version = descriptor->descriptor_version;
+  *transfers_ready = descriptor->transfers_ready;
+  *current_document_token = descriptor->document_token;
+  *max_items = descriptor->max_items;
+  *max_file_bytes = descriptor->max_file_bytes;
+  return Response::Success();
+}
 
