+#include "components/download/public/common/native_download_bridge_descriptor.h"
+
+#include "base/command_line.h"
+#include "components/download/public/common/native_download_budget.h"
+
+namespace download {
+
+NativeDownloadBridgeDescriptor::NativeDownloadBridgeDescriptor()
+    : enabled_(base::CommandLine::ForCurrentProcess()->HasSwitch("remote-paint-token") &&
+               base::CommandLine::ForCurrentProcess()->HasSwitch("remote-paint-download-budget-v1")),
+      token_(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("remote-paint-token")) {}
+NativeDownloadBridgeDescriptor::~NativeDownloadBridgeDescriptor() = default;
+
+std::optional<NativeDownloadBridgeDescriptor::Snapshot>
+NativeDownloadBridgeDescriptor::Describe(std::string_view token,
+                                         std::string_view expected_document,
+                                         std::string_view current_document,
+                                         bool trusted_client,
+                                         bool active_top_frame) const {
+  if (!enabled_ || !trusted_client || !active_top_frame || token_.size() < 32 ||
+      token_.size() > 256 || token != token_ || current_document.empty() ||
+      current_document.size() > 64 || expected_document != current_document)
+    return std::nullopt;
+  // Do not advertise arm/read/release before those operations exist and have
+  // the required file, URL-owner and metadata settlement contracts.
+  return Snapshot{1, false, std::string(current_document),
+                  static_cast<int>(NativeDownloadBudget::kMaxItems),
+                  static_cast<int>(NativeDownloadBudget::kFileBytes)};
+}
+
+}  // namespace download
