@@ -0,0 +1,42 @@
+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_BRIDGE_DESCRIPTOR_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_BRIDGE_DESCRIPTOR_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "components/download/public/common/download_export.h"
+
+namespace download {
+
+// The Page handler supplies its actual trust, top-frame and document witnesses.
+// This descriptor is discovery only; it does not admit or read a download.
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadBridgeDescriptor {
+ public:
+  struct Snapshot {
+    int descriptor_version;
+    bool transfers_ready;
+    std::string document_token;
+    int max_items;
+    int max_file_bytes;
+  };
+
+  NativeDownloadBridgeDescriptor();
+  ~NativeDownloadBridgeDescriptor();
+  NativeDownloadBridgeDescriptor(const NativeDownloadBridgeDescriptor&) = delete;
+  NativeDownloadBridgeDescriptor& operator=(const NativeDownloadBridgeDescriptor&) = delete;
+
+  std::optional<Snapshot> Describe(std::string_view token,
+                                   std::string_view expected_document,
+                                   std::string_view current_document,
+                                   bool trusted_client,
+                                   bool active_top_frame) const;
+
+ private:
+  const bool enabled_;
+  const std::string token_;
+};
+
+}  // namespace download
+
+#endif  // COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_BRIDGE_DESCRIPTOR_H_
