+uint64_t RasterSource::NewRemotePaintSourceId() {
+  static std::atomic<uint64_t> next{1};
+  const auto id = next.fetch_add(1, std::memory_order_relaxed);
+  CHECK_NE(id, 0u);
+  return id;
 }
 
