@@ -0,0 +1,58 @@
+#include "components/download/public/common/native_download_retirement_receipt.h"
+
+#include <atomic>
+#include <utility>
+#include "base/check_op.h"
+#include "components/download/public/common/native_download_arm_window.h"
+
+namespace download {
+namespace { std::atomic<size_t> g_receipts{0}; }
+NativeDownloadRetirementReceipt::NativeDownloadRetirementReceipt(base::UnguessableToken arm)
+    : arm_(arm) {}
+NativeDownloadRetirementReceipt::~NativeDownloadRetirementReceipt() {
+  CHECK_GT(g_receipts.fetch_sub(1), 0u);
+}
+scoped_refptr<NativeDownloadRetirementReceipt> NativeDownloadRetirementReceipt::Create(
+    base::UnguessableToken arm) {
+  auto count = g_receipts.load();
+  while (count < kMaxReceipts) {
+    if (g_receipts.compare_exchange_weak(count, count + 1))
+      return base::WrapRefCounted(new NativeDownloadRetirementReceipt(arm));
+  }
+  return nullptr;
+}
+size_t NativeDownloadRetirementReceipt::LiveReceiptsForTesting() { return g_receipts.load(); }
+void NativeDownloadRetirementReceipt::CloseWindow() {
+  base::AutoLock guard(lock_); window_closed_ = true;
+}
+void NativeDownloadRetirementReceipt::Admitted() {
+  base::AutoLock guard(lock_);
+  CHECK(!window_closed_ && !admitted_); admitted_ = true;
+}
+void NativeDownloadRetirementReceipt::BindRetirement(base::OnceClosure retire) {
+  base::OnceClosure run;
+  {
+    base::AutoLock guard(lock_); CHECK(admitted_ && !bound_ && retire);
+    bound_ = true;
+    if (retire_requested_) run = std::move(retire); else retire_ = std::move(retire);
+  }
+  // The actual budget supplies a weak lease closure posted to its origin.
+  if (run) std::move(run).Run();
+}
+void NativeDownloadRetirementReceipt::Retire() {
+  NativeDownloadArmWindow::Close(arm_);
+  base::OnceClosure run;
+  {
+    base::AutoLock guard(lock_);
+    window_closed_ = true; retire_requested_ = true; run = std::move(retire_);
+  }
+  if (run) std::move(run).Run();
+}
+void NativeDownloadRetirementReceipt::Settled() {
+  base::AutoLock guard(lock_); CHECK(admitted_); settled_ = true; retire_.Reset();
+}
+bool NativeDownloadRetirementReceipt::retired() const {
+  base::AutoLock guard(lock_);
+  return window_closed_ && (!admitted_ || settled_);
+}
+}  // namespace download
