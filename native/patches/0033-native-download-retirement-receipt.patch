+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_RETIREMENT_RECEIPT_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_RETIREMENT_RECEIPT_H_
+
+#include <cstddef>
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/synchronization/lock.h"
+#include "base/unguessable_token.h"
+#include "components/download/public/common/download_export.h"
+
+namespace download {
+// A tiny original-arm receipt, not a reference to a Page, client or lease.
+// Four active windows plus four separately retiring leases fit this bound.
+// No test reset or lifetime quota: actual final reference destruction returns
+// only this tiny metadata slot, never any Native file/lease reservation.
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadRetirementReceipt
+    : public base::RefCountedThreadSafe<NativeDownloadRetirementReceipt> {
+ public:
+  static constexpr size_t kMaxReceipts = 8;
+  void Retire();
+  bool retired() const;
+  static size_t LiveReceiptsForTesting();
+ private:
+  friend class NativeDownloadArmWindow;
+  friend class NativeDownloadBudget;
+  friend class NativeDownloadLease;
+  friend class base::RefCountedThreadSafe<NativeDownloadRetirementReceipt>;
+  explicit NativeDownloadRetirementReceipt(base::UnguessableToken arm);
+  ~NativeDownloadRetirementReceipt();
+  static scoped_refptr<NativeDownloadRetirementReceipt> Create(base::UnguessableToken arm);
+  void CloseWindow();
+  void Admitted();
+  void BindRetirement(base::OnceClosure retire);
+  void Settled();  // Only the original actual lease's Finish may call this.
+  const base::UnguessableToken arm_;
+  mutable base::Lock lock_;
+  bool window_closed_ = false;
+  bool admitted_ = false;
+  bool bound_ = false;
+  bool retire_requested_ = false;
+  bool settled_ = false;
+  base::OnceClosure retire_;
+};
+}  // namespace download
+#endif
