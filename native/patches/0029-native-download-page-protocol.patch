+
+void PageHandler::DetachRemotePaintDownloads() {
+  auto owner = std::move(remote_paint_download_owner_);
+  remote_paint_download_owner_.reset();
+  remote_paint_download_document_.clear();
+  if (owner) owner->ClientDetached(remote_paint_download_client_key_);
+  // Client cancellation may synchronously destroy the handler. No member use.
+}
+
+bool PageHandler::RemotePaintDownloadDocumentMatches(std::string_view document) {
+  if (!is_trusted_ || !AssureTopLevelActiveFrame().IsSuccess() ||
+      host_->IsNestedWithinFencedFrame()) return false;
+  auto* contents = WebContents::FromRenderFrameHost(host_);
+  return contents && contents->GetPrimaryMainFrame() == host_ &&
+      document == host_->GetDocumentToken().ToString();
+}
+
+bool PageHandler::RemotePaintDownloadReplyValid(const std::string& document,
+    base::WeakPtr<NativeDownloadTransferOwner> owner) {
+  return owner && owner.get() == remote_paint_download_owner_.get() &&
+      document == remote_paint_download_document_ &&
+      RemotePaintDownloadDocumentMatches(document) && owner->OwnsDocument(host_);
+}
+
+download::NativeDownloadTransferClient* PageHandler::RemotePaintDownloadClient(
+    int version, const std::string& token, const std::string& document) {
+  if (version != 1 || token.size() < 32 || token.size() > 256 ||
+      document.empty() || document.size() > 64 ||
+      !RemotePaintDownloadDocumentMatches(document) ||
+      !remote_paint_download_bridge_.Describe(token, document, document, is_trusted_, true))
+    return nullptr;
+  auto self = weak_factory_.GetWeakPtr();
+  auto owner = NativeDownloadTransferOwner::GetOrCreateForWebContents(
+      WebContents::FromRenderFrameHost(host_))->GetWeakPtr();
+  if (remote_paint_download_owner_.get() != owner.get() ||
+      remote_paint_download_document_ != document) {
+    DetachRemotePaintDownloads();
+    if (!self || !owner || !RemotePaintDownloadDocumentMatches(document)) return nullptr;
+  }
+  auto* client = owner->ClientForDocument(host_);
+  if (!self || !owner || !client || !RemotePaintDownloadDocumentMatches(document) ||
+      !owner->OwnsDocument(host_)) return nullptr;
+  remote_paint_download_owner_ = owner;
+  remote_paint_download_document_ = document;
+  return client;
+}
+
+Response PageHandler::ArmRemotePaintDownload(int descriptor_version, const std::string& token,
+    const std::string& document_token, int max_bytes, int timeout_ms,
+    int* out_version, std::string* out_document, std::string* out_ticket) {
+  if (max_bytes <= 0 || max_bytes > static_cast<int>(download::NativeDownloadBudget::kFileBytes) ||
+      timeout_ms <= 0 || timeout_ms > 30000)
+    return Response::InvalidParams("Remote Paint download bounds exceeded");
+  auto self = weak_factory_.GetWeakPtr();
+  auto* client = RemotePaintDownloadClient(descriptor_version, token, document_token);
+  if (!self || !client) return Response::ServerError("Remote Paint download bridge unavailable");
+  auto owner = remote_paint_download_owner_;
+  auto ticket = client->Arm(remote_paint_download_client_key_, max_bytes, base::Milliseconds(timeout_ms));
+  if (!self || !ticket || !RemotePaintDownloadReplyValid(document_token, owner))
+    return Response::ServerError("Remote Paint download arm unavailable");
+  *out_version = 1; *out_document = document_token; *out_ticket = std::move(*ticket);
+  return Response::Success();
+}
+
+Response PageHandler::GetRemotePaintDownloadInfo(int descriptor_version, const std::string& token,
+    const std::string& document_token, const std::string& ticket,
+    int* out_version, std::string* out_document, std::string* out_ticket,
+    std::string* phase, std::string* error, int* byte_length,
+    std::string* sha256, std::string* suggested_filename) {
+  if (ticket.size() != 39) return Response::InvalidParams("Invalid Remote Paint download ticket");
+  auto self = weak_factory_.GetWeakPtr();
+  auto* client = RemotePaintDownloadClient(descriptor_version, token, document_token);
+  if (!self || !client) return Response::ServerError("Remote Paint download bridge unavailable");
+  auto owner = remote_paint_download_owner_;
+  auto info = client->Info(remote_paint_download_client_key_, ticket);
+  if (!self || !info || !RemotePaintDownloadReplyValid(document_token, owner))
+    return Response::ServerError("Remote Paint download info unavailable");
+  using State = download::NativeDownloadTransferRegistry::State;
+  using Error = download::NativeDownloadTransferRegistry::Error;
+  switch (info->state) {
+    case State::kIdle: *phase = "idle"; break;
+    case State::kArmed: *phase = "armed"; break;
+    case State::kPending: *phase = "pending"; break;
+    case State::kReady: *phase = "ready"; break;
+    case State::kRetiring: *phase = "retiring"; break;
+    case State::kFailed: *phase = "failed"; break;
+  }
+  switch (info->error) {
+    case Error::kNone: *error = ""; break;
+    case Error::kCancelled: *error = "cancelled"; break;
+    case Error::kTimeout: *error = "timeout"; break;
+    case Error::kUnavailable: *error = "unavailable"; break;
+    case Error::kIo: *error = "io"; break;
+    case Error::kLimit: *error = "limit"; break;
+  }
+  CHECK_LE(info->byte_length, download::NativeDownloadBudget::kFileBytes);
+  CHECK_LE(info->sha256.size(), 64u);
+  CHECK_LE(info->suggested_name.size(), download::NativeDownloadTransferClient::kSuggestedNameBytes);
+  *out_version = 1; *out_document = document_token; *out_ticket = ticket;
+  *byte_length = static_cast<int>(info->byte_length);
+  *sha256 = std::move(info->sha256); *suggested_filename = std::move(info->suggested_name);
+  return Response::Success();
+}
+
+void PageHandler::ReadRemotePaintDownload(int descriptor_version, const std::string& token,
+    const std::string& document_token, const std::string& ticket,
+    int offset, int max_bytes, std::unique_ptr<ReadRemotePaintDownloadCallback> callback) {
+  if (ticket.size() != 39 || offset < 0 ||
+      offset > static_cast<int>(download::NativeDownloadBudget::kFileBytes) ||
+      max_bytes <= 0 || max_bytes > 3072) {
+    callback->sendFailure(Response::InvalidParams("Remote Paint download bounds exceeded")); return;
+  }
+  auto self = weak_factory_.GetWeakPtr();
+  auto* client = RemotePaintDownloadClient(descriptor_version, token, document_token);
+  if (!self || !client) {
+    callback->sendFailure(Response::ServerError("Remote Paint download bridge unavailable")); return;
+  }
+  auto owner = remote_paint_download_owner_;
+  using Reply = base::RefCountedData<std::unique_ptr<ReadRemotePaintDownloadCallback>>;
+  auto reply = base::MakeRefCounted<Reply>(std::move(callback));
+  const bool accepted = client->Read(remote_paint_download_client_key_, ticket, offset, max_bytes,
+      base::BindOnce([](base::WeakPtr<PageHandler> self,
+          base::WeakPtr<NativeDownloadTransferOwner> owner, std::string document,
+          std::string ticket, int offset, int maximum, scoped_refptr<Reply> reply,
+          download::NativeDownloadReadSession::Chunk chunk) {
+        auto callback = std::move(reply->data);
+        if (!callback) return;
+        if (!self || !self->RemotePaintDownloadReplyValid(document, owner) ||
+            chunk.error != download::NativeDownloadReadSession::Error::kNone ||
+            chunk.offset != static_cast<uint64_t>(offset) || chunk.bytes.size() > static_cast<size_t>(maximum) ||
+            chunk.offset + chunk.bytes.size() > download::NativeDownloadBudget::kFileBytes) {
+          callback->sendFailure(Response::ServerError("Remote Paint download read unavailable")); return;
+        }
+        const int next = offset + static_cast<int>(chunk.bytes.size());
+        callback->sendSuccess(1, document, ticket, offset, next, chunk.complete,
+            Binary::fromString(std::move(chunk.bytes)));
+      }, self, owner, document_token, ticket, offset, max_bytes, reply));
+  // Rejection destroys the Native callback; the local shared slot still owns
+  // the protocol callback and explicitly answers it. An accepted synchronous
+  // callback can destroy this handler; only locals are used below.
+  if (!accepted && reply->data) {
+    auto rejected = std::move(reply->data);
+    rejected->sendFailure(Response::ServerError("Remote Paint download read rejected"));
+  }
+}
+
+void PageHandler::ReleaseRemotePaintDownload(int descriptor_version, const std::string& token,
+    const std::string& document_token, const std::string& ticket,
+    std::unique_ptr<ReleaseRemotePaintDownloadCallback> callback) {
+  if (ticket.size() != 39) {
+    callback->sendFailure(Response::InvalidParams("Invalid Remote Paint download ticket")); return;
+  }
+  auto self = weak_factory_.GetWeakPtr();
+  auto* client = RemotePaintDownloadClient(descriptor_version, token, document_token);
+  if (!self || !client) {
+    callback->sendFailure(Response::ServerError("Remote Paint download bridge unavailable")); return;
+  }
+  auto owner = remote_paint_download_owner_;
+  using Reply = base::RefCountedData<std::unique_ptr<ReleaseRemotePaintDownloadCallback>>;
+  auto reply = base::MakeRefCounted<Reply>(std::move(callback));
+  const bool accepted = client->Release(remote_paint_download_client_key_, ticket, base::BindOnce(
+      [](base::WeakPtr<PageHandler> self, base::WeakPtr<NativeDownloadTransferOwner> owner,
+          std::string document, std::string ticket, scoped_refptr<Reply> reply, bool success) {
+        auto callback = std::move(reply->data);
+        if (!callback) return;
+        // Successful physical settlement already cleared the key binding. Check
+        // the original handler/owner/document, not the now-absent ticket.
+        if (!self || !self->RemotePaintDownloadReplyValid(document, owner)) {
+          callback->sendFailure(Response::ServerError("Remote Paint download release unavailable")); return;
+        }
+        callback->sendSuccess(1, document, ticket, success);
+      }, self, owner, document_token, ticket, reply));
+  if (!accepted && reply->data) {
+    auto rejected = std::move(reply->data);
+    rejected->sendFailure(Response::ServerError("Remote Paint download release rejected"));
+  }
+}
 
