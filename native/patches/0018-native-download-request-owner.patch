+// Native browser-side URL-handler retirement. This is not network-service ACK.
+#include "components/download/public/common/url_download_handler.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace download {
+UrlDownloadHandler::UrlDownloadHandler()
+    : cleanup_state_(base::CommandLine::ForCurrentProcess()->HasSwitch(
+                         "remote-paint-token")
+                         ? base::MakeRefCounted<UrlDownloadHandlerCleanupState>()
+                         : nullptr) {}
+
+UrlDownloadHandler::~UrlDownloadHandler() {
+  if (cleanup_state_) {
+    auto expected = UrlDownloadHandlerCleanupState::Phase::Active;
+    // Destruction outside the retirement wrapper has no origin acknowledgement.
+    cleanup_state_->phase_.compare_exchange_strong(
+        expected, UrlDownloadHandlerCleanupState::Phase::Failed);
+  }
+}
+
+void RetireUrlDownloadHandler(
+    UrlDownloadHandler::UniqueUrlDownloadHandlerPtr handler) {
+  if (!handler)
+    return;
+  auto state = handler->GetRemotePaintRequestCleanupState();
+  if (!state)
+    return;  // Original non-Native deleter behavior.
+  using Phase = UrlDownloadHandlerCleanupState::Phase;
+  auto expected = Phase::Active;
+  if (!state->phase_.compare_exchange_strong(expected, Phase::Queued) ||
+      !base::SequencedTaskRunner::HasCurrentDefault()) {
+    state->phase_.store(Phase::Failed, std::memory_order_release);
+    return;
+  }
+  auto runner = handler.get_deleter().task_runner_;
+  const bool posted = runner->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](UrlDownloadHandler::UniqueUrlDownloadHandlerPtr pending,
+             scoped_refptr<UrlDownloadHandlerCleanupState> state) {
+            std::unique_ptr<UrlDownloadHandler> owner(pending.release());
+            owner.reset();  // Derived members and endpoints gone before reply.
+            state->phase_.store(Phase::OwnerDestroyed, std::memory_order_release);
+            return true;
+          }, std::move(handler), state),
+      base::BindOnce([](scoped_refptr<UrlDownloadHandlerCleanupState> state,
+                        bool destroyed) {
+        auto expected = Phase::OwnerDestroyed;
+        if (!destroyed || !state->phase_.compare_exchange_strong(
+                              expected, Phase::Acknowledged))
+          state->phase_.store(Phase::Failed, std::memory_order_release);
+      }, state));
+  if (!posted)
+    state->phase_.store(Phase::Failed, std::memory_order_release);
+  // A rejected IO post keeps sequence-safe ownership in the original deleter.
+  // A dropped origin reply leaves OwnerDestroyed, never Acknowledged.
+}
+}  // namespace download
