+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_TRANSFER_REGISTRY_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_TRANSFER_REGISTRY_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/download/public/common/download_export.h"
+#include "components/download/public/common/download_item.h"
+#include "components/download/public/common/native_download_read_session.h"
+
+namespace download {
+class NativeDownloadLease;
+class NativeDownloadRequestContext;
+
+// One origin-sequence ticket. The browser must own exactly one of these per
+// WebContents, authenticate commands and offer actual new manager admissions.
+// This core never scans history or reconstructs request provenance.
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadTransferRegistry : public DownloadItem::Observer {
+ public:
+  enum class State { kIdle, kArmed, kPending, kReady, kRetiring, kFailed };
+  enum class Error { kNone, kCancelled, kTimeout, kUnavailable, kIo, kLimit };
+  struct Snapshot {
+    State state;
+    Error error;
+    uint64_t byte_length;
+    std::string sha256;
+  };
+  explicit NativeDownloadTransferRegistry(scoped_refptr<NativeDownloadRequestContext> owner);
+  ~NativeDownloadTransferRegistry() override;
+  NativeDownloadTransferRegistry(const NativeDownloadTransferRegistry&) = delete;
+  NativeDownloadTransferRegistry& operator=(const NativeDownloadTransferRegistry&) = delete;
+  std::optional<std::string> Arm(uint64_t maximum_bytes, base::TimeDelta timeout);
+  // A single claim is retained for the lease lifetime, including repeated
+  // observer notifications. Rejected unrelated leases remain their owner's job.
+  bool Offer(scoped_refptr<NativeDownloadLease> lease);
+  std::optional<Snapshot> Info(std::string_view ticket);
+  bool Read(std::string_view ticket, uint64_t offset, uint32_t maximum_bytes,
+            NativeDownloadReadSession::ReadCallback done);
+  // Acceptance is not retirement. At most one release callback, true only after
+  // the actual lease has finished all file/URL/item/map settlement. A 30s reply
+  // deadline or failure reports false and keeps the ticket/reservation held.
+  bool Release(std::string_view ticket, base::OnceCallback<void(bool)> done);
+  void Invalidate();
+  void OnDownloadUpdated(DownloadItem* item) override;
+  void OnDownloadDestroyed(DownloadItem* item) override;
+ private:
+  bool Matches(std::string_view ticket) const;
+  void Expire();
+  void BeginRetire(Error error);
+  void Poll();
+  void Step();
+  void Schedule();
+  void OnReady(NativeDownloadReadSession::Metadata metadata);
+  void OnRead(NativeDownloadReadSession::ReadCallback done, NativeDownloadReadSession::Chunk chunk);
+  void ReplyRelease(bool success);
+  void Clear();
+  const bool enabled_;
+  scoped_refptr<NativeDownloadRequestContext> owner_;
+  scoped_refptr<NativeDownloadLease> lease_;
+  raw_ptr<DownloadItem> item_ = nullptr;
+  std::unique_ptr<NativeDownloadReadSession> reader_;
+  std::string ticket_;
+  State state_ = State::kIdle;
+  Error error_ = Error::kNone;
+  uint64_t maximum_bytes_ = 0;
+  NativeDownloadReadSession::Metadata metadata_;
+  base::TimeTicks armed_at_;
+  base::TimeTicks deadline_;
+  base::TimeTicks release_deadline_;
+  bool release_requested_ = false;
+  base::OnceCallback<void(bool)> release_callback_;
+  base::OneShotTimer timer_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<NativeDownloadTransferRegistry> weak_{this};
+};
+}  // namespace download
+#endif
