+#include "components/download/public/common/native_download_transfer_registry.h"
+
+#include <algorithm>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+#include "components/download/public/common/native_download_budget.h"
+#include "components/download/public/common/native_download_request_context.h"
+
+namespace download {
+namespace {
+constexpr auto kPoll = base::Milliseconds(50);
+constexpr auto kMaximumTimeout = base::Seconds(30);
+}
+NativeDownloadTransferRegistry::NativeDownloadTransferRegistry(
+    scoped_refptr<NativeDownloadRequestContext> owner)
+    : enabled_(NativeDownloadRequestContext::EnabledForProcess()), owner_(std::move(owner)) {}
+NativeDownloadTransferRegistry::~NativeDownloadTransferRegistry() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  weak_.InvalidateWeakPtrs(); timer_.Stop();
+  if (item_) item_->RemoveObserver(this);
+  item_ = nullptr;
+  reader_.reset();
+  if (lease_) lease_->BeginRetire();
+}
+std::optional<std::string> NativeDownloadTransferRegistry::Arm(uint64_t maximum_bytes, base::TimeDelta timeout) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!enabled_ || !owner_ || !ticket_.empty() || !maximum_bytes ||
+      maximum_bytes > NativeDownloadBudget::kFileBytes || timeout <= base::TimeDelta() || timeout > kMaximumTimeout)
+    return std::nullopt;
+  ticket_ = "dl_" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+  maximum_bytes_ = maximum_bytes; armed_at_ = base::TimeTicks::Now();
+  deadline_ = armed_at_ + timeout; state_ = State::kArmed;
+  Schedule(); return ticket_;
+}
+bool NativeDownloadTransferRegistry::Matches(std::string_view ticket) const {
+  return !ticket_.empty() && ticket.size() == ticket_.size() && ticket == ticket_;
+}
+bool NativeDownloadTransferRegistry::Offer(scoped_refptr<NativeDownloadLease> lease) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Expire();
+  if (state_ != State::kArmed || !lease || lease->created_at() < armed_at_ ||
+      !lease->request_context() || !owner_->SamePageDocument(*lease->request_context()) || !lease->ClaimTransfer())
+    return false;
+  lease_ = std::move(lease); item_ = lease_->transfer_item();
+  item_->AddObserver(this); state_ = State::kPending;
+  Poll(); return true;
+}
+std::optional<NativeDownloadTransferRegistry::Snapshot> NativeDownloadTransferRegistry::Info(std::string_view ticket) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Matches(ticket)) return std::nullopt;
+  Expire();
+  return Snapshot{state_, error_, metadata_.byte_length, metadata_.sha256};
+}
+bool NativeDownloadTransferRegistry::Read(std::string_view ticket, uint64_t offset, uint32_t maximum_bytes,
+    NativeDownloadReadSession::ReadCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Matches(ticket)) return false;
+  Expire();
+  if (state_ != State::kReady || !reader_ || !done) return false;
+  return reader_->Read(offset, maximum_bytes, base::BindOnce(
+      &NativeDownloadTransferRegistry::OnRead, weak_.GetWeakPtr(), std::move(done)));
+}
+bool NativeDownloadTransferRegistry::Release(std::string_view ticket, base::OnceCallback<void(bool)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Matches(ticket) || !done || release_requested_) return false;
+  release_requested_ = true; release_callback_ = std::move(done);
+  release_deadline_ = base::TimeTicks::Now() + kMaximumTimeout;
+  BeginRetire(Error::kCancelled);
+  Poll(); return true;
+}
+void NativeDownloadTransferRegistry::Invalidate() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Invalidation is permanent for this document. A later browser document must
+  // get a new owned registry; it cannot rebind a retained ticket to itself.
+  owner_.reset();
+  if (!ticket_.empty()) { BeginRetire(Error::kUnavailable); Poll(); }
+}
+void NativeDownloadTransferRegistry::Expire() {
+  if ((state_ == State::kArmed || state_ == State::kPending || state_ == State::kReady) &&
+      base::TimeTicks::Now() >= deadline_) {
+    BeginRetire(Error::kTimeout); Schedule();
+  }
+}
+void NativeDownloadTransferRegistry::BeginRetire(Error error) {
+  if (error_ == Error::kNone) error_ = error;
+  state_ = State::kRetiring;
+  if (reader_) reader_->Close();
+  if (lease_) lease_->BeginRetire();
+}
+void NativeDownloadTransferRegistry::Poll() {
+  auto self = weak_.GetWeakPtr();
+  Step();
+  if (self) self->Schedule();
+}
+void NativeDownloadTransferRegistry::Step() {
+  if (ticket_.empty()) return;
+  Expire();
+  if (!lease_ || lease_->finished()) {
+    if (release_requested_) { ReplyRelease(true); return; }
+    if (state_ == State::kRetiring) state_ = State::kFailed;
+    return;
+  }
+  if (lease_->failed()) {
+    state_ = State::kFailed;
+    if (error_ == Error::kNone) error_ = Error::kUnavailable;
+    if (reader_) reader_->Close();
+    ReplyRelease(false); return;
+  }
+  if (state_ == State::kRetiring) {
+    if (release_callback_ && base::TimeTicks::Now() >= release_deadline_) ReplyRelease(false);
+    return;
+  }
+  if (lease_->retiring() || !item_) { BeginRetire(Error::kUnavailable); return; }
+  if (state_ == State::kPending && !reader_) {
+    if (item_->GetState() == DownloadItem::CANCELLED || item_->GetState() == DownloadItem::INTERRUPTED) {
+      BeginRetire(Error::kUnavailable); return;
+    }
+    if (item_->GetState() == DownloadItem::COMPLETE)
+      reader_ = lease_->OpenReader(maximum_bytes_, base::BindOnce(
+          &NativeDownloadTransferRegistry::OnReady, weak_.GetWeakPtr()));
+  }
+}
+void NativeDownloadTransferRegistry::Schedule() {
+  timer_.Stop();
+  if (ticket_.empty() || state_ == State::kFailed) return;
+  auto delay = deadline_ - base::TimeTicks::Now();
+  if (state_ == State::kRetiring || (state_ == State::kPending && !reader_))
+    delay = kPoll;
+  timer_.Start(FROM_HERE, std::max(delay, base::TimeDelta()),
+      base::BindOnce(&NativeDownloadTransferRegistry::Poll, weak_.GetWeakPtr()));
+}
+void NativeDownloadTransferRegistry::OnReady(NativeDownloadReadSession::Metadata metadata) {
+  if (state_ != State::kPending || base::TimeTicks::Now() >= deadline_) {
+    if (state_ == State::kPending) BeginRetire(Error::kTimeout);
+    Poll(); return;
+  }
+  if (metadata.error != NativeDownloadReadSession::Error::kNone) {
+    BeginRetire(metadata.error == NativeDownloadReadSession::Error::kLimit ? Error::kLimit : Error::kIo);
+  } else { metadata_ = std::move(metadata); state_ = State::kReady; }
+  Poll();
+}
+void NativeDownloadTransferRegistry::OnRead(NativeDownloadReadSession::ReadCallback done,
+    NativeDownloadReadSession::Chunk chunk) {
+  Expire();
+  if (state_ != State::kReady) chunk = {NativeDownloadReadSession::Error::kClosed, chunk.offset, {}, false};
+  if (chunk.error != NativeDownloadReadSession::Error::kNone && state_ == State::kReady) {
+    BeginRetire(Error::kIo); Schedule();
+  }
+  std::move(done).Run(std::move(chunk));
+}
+void NativeDownloadTransferRegistry::OnDownloadUpdated(DownloadItem*) { Poll(); }
+void NativeDownloadTransferRegistry::OnDownloadDestroyed(DownloadItem*) {
+  item_ = nullptr;
+  if (state_ != State::kRetiring) BeginRetire(Error::kUnavailable);
+  // Destruction notification is never item/map retirement success.
+  Schedule();
+}
+void NativeDownloadTransferRegistry::ReplyRelease(bool success) {
+  auto done = std::move(release_callback_);
+  if (success) Clear();
+  if (done) std::move(done).Run(success);
+}
+void NativeDownloadTransferRegistry::Clear() {
+  timer_.Stop();
+  if (item_) item_->RemoveObserver(this);
+  item_ = nullptr; reader_.reset(); lease_.reset(); ticket_.clear();
+  state_ = State::kIdle; error_ = Error::kNone; metadata_ = {};
+  maximum_bytes_ = 0; release_requested_ = false;
+}
+}  // namespace download
