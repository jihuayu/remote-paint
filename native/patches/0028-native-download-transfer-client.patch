+      base::OnceCallback<void(bool)> done);
+  bool OwnsClient(const base::UnguessableToken& client) const;
+  // Permanently invalidates this document facade. Settles each accepted client
+  // reply exactly once with failure; actual lease retirement stays independent.
+  void Invalidate();
+ private:
+  bool Owned(const base::UnguessableToken& client, std::string_view ticket) const;
+  bool Refresh();
+  void ClearBinding();
+  void OnRead(base::UnguessableToken operation, NativeDownloadReadSession::Chunk chunk);
+  void ReadTimedOut();
+  void OnRelease(bool success);
+  NativeDownloadTransferRegistry registry_;
+  base::UnguessableToken client_;
+  std::string ticket_;
+  base::TimeTicks deadline_;
+  bool closed_ = false;
+  base::UnguessableToken read_operation_;
+  uint64_t read_offset_ = 0;
+  ReadCallback read_reply_;
+  base::OnceCallback<void(bool)> release_reply_;
+  base::OneShotTimer read_timer_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<NativeDownloadTransferClient> weak_{this};
+};
+}  // namespace download
