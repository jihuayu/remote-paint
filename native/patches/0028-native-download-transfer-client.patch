+#include "components/download/public/common/native_download_transfer_client.h"
+
+#include <algorithm>
+#include <utility>
+#include "base/functional/bind.h"
+#include "components/download/public/common/native_download_budget.h"
+#include "components/download/public/common/native_download_request_context.h"
+
+namespace download {
+NativeDownloadTransferClient::NativeDownloadTransferClient(scoped_refptr<NativeDownloadRequestContext> owner)
+    : registry_(std::move(owner)) {}
+NativeDownloadTransferClient::~NativeDownloadTransferClient() { Invalidate(); }
+bool NativeDownloadTransferClient::OwnsClient(const base::UnguessableToken& client) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return !closed_ && !client.is_empty() && !ticket_.empty() && client == client_;
+}
+bool NativeDownloadTransferClient::Owned(const base::UnguessableToken& client, std::string_view ticket) const {
+  return OwnsClient(client) && ticket.size() == ticket_.size() && ticket == ticket_;
+}
+void NativeDownloadTransferClient::ClearBinding() {
+  client_ = {}; ticket_.clear(); deadline_ = {};
+}
+bool NativeDownloadTransferClient::Refresh() {
+  // A release reply may already have failed its 30s response deadline. Only
+  // the real registry's later physical settlement can make the ticket absent.
+  if (!ticket_.empty() && !read_reply_ && !release_reply_) {
+    auto self = weak_.GetWeakPtr(); auto info = registry_.Info(ticket_);
+    if (!self) return false;
+    if (!info) ClearBinding();
+  }
+  return true;
+}
+std::optional<std::string> NativeDownloadTransferClient::Arm(const base::UnguessableToken& client,
+    uint64_t maximum_bytes, base::TimeDelta timeout) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_ || client.is_empty()) return std::nullopt;
+  if (!Refresh()) return std::nullopt;
+  if (!ticket_.empty()) return std::nullopt;
+  const auto start = base::TimeTicks::Now();
+  auto ticket = registry_.Arm(maximum_bytes, timeout);
+  if (ticket) { client_ = client; ticket_ = *ticket; deadline_ = start + timeout; }
+  return ticket;
+}
+bool NativeDownloadTransferClient::Offer(scoped_refptr<NativeDownloadLease> lease) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return !closed_ && registry_.Offer(std::move(lease));
+}
+std::optional<NativeDownloadTransferClient::Snapshot> NativeDownloadTransferClient::Info(
+    const base::UnguessableToken& client, std::string_view ticket) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Owned(client, ticket)) return std::nullopt;
+  auto self = weak_.GetWeakPtr(); auto info = registry_.Info(ticket);
+  if (!self) return std::nullopt;
+  if (!info && !read_reply_ && !release_reply_) ClearBinding();
+  return info;
+}
+bool NativeDownloadTransferClient::Read(const base::UnguessableToken& client, std::string_view ticket,
+    uint64_t offset, uint32_t maximum_bytes, ReadCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Owned(client, ticket) || !done || read_reply_ || base::TimeTicks::Now() >= deadline_) return false;
+  read_reply_ = std::move(done); read_offset_ = offset;
+  read_operation_ = base::UnguessableToken::Create();
+  auto self = weak_.GetWeakPtr();
+  const bool accepted = registry_.Read(ticket, offset, maximum_bytes, base::BindOnce(
+      &NativeDownloadTransferClient::OnRead, weak_.GetWeakPtr(), read_operation_));
+  if (!self) return accepted;
+  if (!accepted) { read_reply_.Reset(); read_operation_ = {}; return false; }
+  read_timer_.Start(FROM_HERE, std::max(deadline_ - base::TimeTicks::Now(), base::TimeDelta()),
+      base::BindOnce(&NativeDownloadTransferClient::ReadTimedOut, weak_.GetWeakPtr()));
+  return true;
+}
+bool NativeDownloadTransferClient::Release(const base::UnguessableToken& client, std::string_view ticket,
+    base::OnceCallback<void(bool)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!Owned(client, ticket) || !done || release_reply_) return false;
+  release_reply_ = std::move(done);
+  const bool accepted = registry_.Release(ticket, base::BindOnce(
+      &NativeDownloadTransferClient::OnRelease, weak_.GetWeakPtr()));
+  // An unused arm can finish and destroy this facade synchronously. A true
+  // result must return without touching any members after the callback.
+  if (!accepted) release_reply_.Reset();
+  return accepted;
+}
+void NativeDownloadTransferClient::OnRead(base::UnguessableToken operation, NativeDownloadReadSession::Chunk chunk) {
+  if (operation != read_operation_ || !read_reply_) return;
+  read_timer_.Stop(); read_operation_ = {};
+  auto done = std::move(read_reply_);
+  std::move(done).Run(std::move(chunk));
+}
+void NativeDownloadTransferClient::ReadTimedOut() {
+  auto done = std::move(read_reply_); const auto offset = read_offset_; read_operation_ = {};
+  // Query drives an overdue core into retirement. A nested release callback may
+  // destroy this facade; only local reply values are used after this point.
+  registry_.Info(ticket_);
+  if (done) std::move(done).Run({NativeDownloadReadSession::Error::kClosed, offset, {}, false});
+}
+void NativeDownloadTransferClient::OnRelease(bool success) {
+  auto read = std::move(read_reply_); auto released = std::move(release_reply_);
+  const auto offset = read_offset_; read_timer_.Stop(); read_operation_ = {};
+  if (success) ClearBinding();
+  // Complete both from locals, so the first callback can destroy the owner.
+  if (read) std::move(read).Run({NativeDownloadReadSession::Error::kClosed, offset, {}, false});
+  if (released) std::move(released).Run(success);
+}
+void NativeDownloadTransferClient::Invalidate() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_) return;
+  closed_ = true; weak_.InvalidateWeakPtrs(); read_timer_.Stop(); read_operation_ = {};
+  auto read = std::move(read_reply_); auto released = std::move(release_reply_);
+  const auto offset = read_offset_; ClearBinding();
+  registry_.Invalidate();
+  // These are failure replies, never physical retirement credit. The complete
+  // actual file/URL/item/map lease still holds its reservation independently.
+  if (read) std::move(read).Run({NativeDownloadReadSession::Error::kClosed, offset, {}, false});
+  if (released) std::move(released).Run(false);
+}
+}  // namespace download
