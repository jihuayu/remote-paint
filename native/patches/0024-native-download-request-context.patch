+#include "components/download/public/common/native_download_request_context.h"
+#include <utility>
+#include "base/command_line.h"
+
+namespace download {
+namespace {
+bool Valid(const NativeDownloadRequestContext::Frame& frame) {
+  return frame.process_id >= 0 && frame.routing_id >= 0 &&
+         !frame.document_token.empty() && frame.document_token.size() <= 64;
+}
+}  // namespace
+bool NativeDownloadRequestContext::EnabledForProcess() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch("remote-paint-token") &&
+         cmd->HasSwitch("remote-paint-download-budget-v1");
+}
+scoped_refptr<NativeDownloadRequestContext> NativeDownloadRequestContext::Create(
+    Origin origin, Frame target, Frame initiator, Frame page) {
+  if (!EnabledForProcess() || !Valid(target) || !Valid(initiator) || !Valid(page))
+    return nullptr;
+  switch (origin) {
+    case Origin::kBrowserNavigation:
+    case Origin::kRendererNavigation:
+    case Origin::kExplicitRequest: break;
+    default: return nullptr;
+  }
+  return base::WrapRefCounted(new NativeDownloadRequestContext(
+      origin, std::move(target), std::move(initiator), std::move(page)));
+}
+NativeDownloadRequestContext::NativeDownloadRequestContext(
+    Origin origin, Frame target, Frame initiator, Frame page)
+    : origin_(origin), target_(std::move(target)), initiator_(std::move(initiator)),
+      page_(std::move(page)), request_id_(base::UnguessableToken::Create()) {}
+NativeDownloadRequestContext::~NativeDownloadRequestContext() = default;
+bool NativeDownloadRequestContext::SamePageDocument(
+    const NativeDownloadRequestContext& other) const {
+  return page_.process_id == other.page_.process_id &&
+         page_.routing_id == other.page_.routing_id &&
+         page_.document_token == other.page_.document_token;
+}
+}  // namespace download
