+scoped_refptr<download::NativeDownloadRequestContext>
+DownloadManagerImpl::CaptureNativeRequestContext(
+    RenderFrameHostImpl* target,
+    RenderFrameHostImpl* initiator,
+    download::NativeDownloadRequestContext::Origin origin) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  using Context = download::NativeDownloadRequestContext;
+  if (!Context::EnabledForProcess() || !target || !initiator ||
+      !target->IsActive() || !initiator->IsActive() ||
+      target->IsNestedWithinFencedFrame() || initiator->IsNestedWithinFencedFrame())
+    return nullptr;
+  auto* contents = WebContents::FromRenderFrameHost(target);
+  if (!contents || contents != WebContents::FromRenderFrameHost(initiator)) return nullptr;
+  auto* page = static_cast<RenderFrameHostImpl*>(contents->GetPrimaryMainFrame());
+  if (!page || !page->IsActive()) return nullptr;
+  auto frame = [](RenderFrameHostImpl* host) {
+    return Context::Frame{host->GetProcess()->GetDeprecatedID(), host->GetRoutingID(),
+                          host->GetDocumentToken().ToString()};
+  };
+  return Context::Create(origin, frame(target), frame(initiator), frame(page));
+}
