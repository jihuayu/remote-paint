+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_REQUEST_CONTEXT_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_REQUEST_CONTEXT_H_
+
+#include <string>
+#include "base/memory/ref_counted.h"
+#include "base/unguessable_token.h"
+#include "components/download/public/common/download_export.h"
+
+namespace download {
+// Captured by browser code at request creation. No RFH or WebContents pointer
+// crosses to IO, and no response-time frame lookup can rewrite this record.
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadRequestContext
+    : public base::RefCountedThreadSafe<NativeDownloadRequestContext> {
+ public:
+  enum class Origin { kBrowserNavigation, kRendererNavigation, kExplicitRequest };
+  struct Frame {
+    int process_id;
+    int routing_id;
+    std::string document_token;
+  };
+  static bool EnabledForProcess();
+  static scoped_refptr<NativeDownloadRequestContext> Create(
+      Origin origin, Frame target, Frame initiator, Frame page);
+  const Frame& target() const { return target_; }
+  const Frame& initiator() const { return initiator_; }
+  const Frame& page() const { return page_; }
+  Origin origin() const { return origin_; }
+  const base::UnguessableToken& request_id() const { return request_id_; }
+  bool SamePageDocument(const NativeDownloadRequestContext& other) const;
+ private:
+  friend class base::RefCountedThreadSafe<NativeDownloadRequestContext>;
+  NativeDownloadRequestContext(Origin origin, Frame target, Frame initiator, Frame page);
+  ~NativeDownloadRequestContext();
+  const Origin origin_;
+  const Frame target_;
+  const Frame initiator_;
+  const Frame page_;
+  const base::UnguessableToken request_id_;
+};
+}  // namespace download
+#endif
