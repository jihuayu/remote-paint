+#include "content/browser/download/native_download_transfer_owner.h"
+
+#include <utility>
+#include "components/download/public/common/download_item.h"
+#include "components/download/public/common/native_download_budget.h"
+#include "components/download/public/common/native_download_request_context.h"
+#include "components/download/public/common/native_download_transfer_registry.h"
+#include "content/browser/download/download_manager_impl.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/web_contents.h"
+
+namespace content {
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NativeDownloadTransferOwner);
+NativeDownloadTransferOwner::NativeDownloadTransferOwner(WebContents* contents)
+    : WebContentsObserver(contents), WebContentsUserData(*contents),
+      enabled_(download::NativeDownloadRequestContext::EnabledForProcess()) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (enabled_) {
+    manager_ = contents->GetBrowserContext()->GetDownloadManager();
+    if (manager_) manager_->AddObserver(this);
+  }
+}
+NativeDownloadTransferOwner::~NativeDownloadTransferOwner() {
+  weak_.InvalidateWeakPtrs();
+  UnobserveManager();
+  // Destruction drops pending client callbacks; the core destructor still
+  // closes its actual reader and starts the independently retained lease gate.
+  registry_.reset(); original_page_.reset();
+}
+download::NativeDownloadTransferRegistry* NativeDownloadTransferOwner::RegistryForDocument(
+    RenderFrameHost* current) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!enabled_ || closed_ || !manager_ || !web_contents() || !current ||
+      current != web_contents()->GetPrimaryMainFrame() || !current->IsActive() ||
+      current->IsNestedWithinFencedFrame()) return nullptr;
+  auto* actual = static_cast<RenderFrameHostImpl*>(current);
+  auto captured = DownloadManagerImpl::CaptureNativeRequestContext(
+      actual, actual, download::NativeDownloadRequestContext::Origin::kExplicitRequest);
+  if (!captured) return nullptr;
+  if (original_page_ && !original_page_->SamePageDocument(*captured)) {
+    auto self = weak_.GetWeakPtr();
+    RetireDocument();
+    if (!self || closed_ || !manager_ || !web_contents() ||
+        current != web_contents()->GetPrimaryMainFrame() || !current->IsActive() ||
+        current->IsNestedWithinFencedFrame()) return nullptr;
+    actual = static_cast<RenderFrameHostImpl*>(current);
+    captured = DownloadManagerImpl::CaptureNativeRequestContext(
+        actual, actual, download::NativeDownloadRequestContext::Origin::kExplicitRequest);
+    if (!captured) return nullptr;
+  }
+  if (!registry_) {
+    original_page_ = std::move(captured);
+    registry_ = std::make_unique<download::NativeDownloadTransferRegistry>(original_page_);
+  }
+  return registry_.get();
+}
+void NativeDownloadTransferOwner::OnDownloadCreated(DownloadManager* manager, download::DownloadItem* item) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (closed_ || manager != manager_ || !registry_ || !item) return;
+  // Read the admission retained by the actual item. The core matches its
+  // original immutable Page and arm-time/lifetime claim; no current frame can
+  // repair missing provenance or adopt a historical/other-Page item here.
+  auto lease = item->GetRemotePaintAdmission();
+  if (lease) registry_->Offer(std::move(lease));
+}
+void NativeDownloadTransferOwner::UnobserveManager() {
+  if (manager_) manager_->RemoveObserver(this);
+  manager_ = nullptr;
+}
+void NativeDownloadTransferOwner::ManagerGoingDown(DownloadManager* manager) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (manager != manager_) return;
+  UnobserveManager(); RetireDocument();
+}
+void NativeDownloadTransferOwner::RetireDocument() {
+  // Move first: a release callback delivered by Invalidate may re-enter browser
+  // teardown. Never touch this owner after running that callback.
+  auto previous = std::move(registry_);
+  original_page_.reset();
+  if (previous) previous->Invalidate();
+}
+void NativeDownloadTransferOwner::PrimaryPageChanged(Page&) {
+  // A download navigation can start without committing. Only the actual primary
+  // Page change retires its original document; same-document changes keep it.
+  RetireDocument();
+}
+void NativeDownloadTransferOwner::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {
+  RetireDocument();
+}
+void NativeDownloadTransferOwner::WebContentsDestroyed() {
+  closed_ = true; UnobserveManager(); RetireDocument();
+}
+}  // namespace content
