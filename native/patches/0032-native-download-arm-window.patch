+#include "components/download/public/common/native_download_arm_window.h"
+
+#include <array>
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "components/download/public/common/native_download_budget.h"
+
+namespace download {
+namespace {
+using Frame = NativeDownloadRequestContext::Frame;
+using Window = NativeDownloadArmWindow::Window;
+struct Entry { Frame page; Window window; bool consumed = false; };
+struct State {
+  base::Lock lock;
+  std::array<std::optional<Entry>, NativeDownloadBudget::kMaxItems> entries;
+};
+State& Slots() { static base::NoDestructor<State> state; return *state; }
+bool Same(const Frame& a, const Frame& b) {
+  return a.process_id == b.process_id && a.routing_id == b.routing_id &&
+      a.document_token == b.document_token;
+}
+void Prune(State& state, base::TimeTicks now) {
+  for (auto& entry : state.entries)
+    if (entry && now >= entry->window.deadline) entry.reset();
+}
+bool Matches(const Entry& entry, const NativeDownloadRequestContext& request) {
+  return entry.window.id == request.arm_id() && Same(entry.page, request.page());
+}
+}  // namespace
+std::optional<Window> NativeDownloadArmWindow::Open(const NativeDownloadRequestContext& owner,
+    uint64_t maximum_bytes, base::TimeDelta timeout) {
+  if (!NativeDownloadRequestContext::EnabledForProcess() || !maximum_bytes ||
+      maximum_bytes > NativeDownloadBudget::kFileBytes || timeout <= base::TimeDelta() ||
+      timeout > base::Seconds(30)) return std::nullopt;
+  auto& state = Slots(); base::AutoLock guard(state.lock);
+  const auto now = base::TimeTicks::Now(); Prune(state, now);
+  for (const auto& entry : state.entries)
+    if (entry && Same(entry->page, owner.page())) return std::nullopt;
+  for (auto& entry : state.entries) {
+    if (!entry) {
+      Window window{base::UnguessableToken::Create(), now, now + timeout, maximum_bytes};
+      entry = Entry{owner.page(), window}; return window;
+    }
+  }
+  return std::nullopt;
+}
+base::UnguessableToken NativeDownloadArmWindow::Capture(const Frame& page) {
+  if (!NativeDownloadRequestContext::EnabledForProcess()) return {};
+  auto& state = Slots(); base::AutoLock guard(state.lock); Prune(state, base::TimeTicks::Now());
+  for (const auto& entry : state.entries)
+    if (entry && Same(entry->page, page)) return entry->window.id;
+  return {};
+}
+std::optional<Window> NativeDownloadArmWindow::Consume(const NativeDownloadRequestContext& request) {
+  if (request.arm_id().is_empty() || !NativeDownloadRequestContext::EnabledForProcess()) return std::nullopt;
+  auto& state = Slots(); base::AutoLock guard(state.lock); Prune(state, base::TimeTicks::Now());
+  for (auto& entry : state.entries) {
+    if (entry && !entry->consumed && Matches(*entry, request)) {
+      entry->consumed = true; return entry->window;
+    }
+  }
+  return std::nullopt;
+}
+bool NativeDownloadArmWindow::AllowsResume(const NativeDownloadRequestContext& request) {
+  if (request.arm_id().is_empty() || !NativeDownloadRequestContext::EnabledForProcess()) return false;
+  auto& state = Slots(); base::AutoLock guard(state.lock); Prune(state, base::TimeTicks::Now());
+  for (const auto& entry : state.entries)
+    if (entry && entry->consumed && Matches(*entry, request)) return true;
+  return false;
+}
+void NativeDownloadArmWindow::Close(const base::UnguessableToken& id) {
+  if (id.is_empty()) return;
+  auto& state = Slots(); base::AutoLock guard(state.lock);
+  for (auto& entry : state.entries) if (entry && entry->window.id == id) { entry.reset(); return; }
+}
+size_t NativeDownloadArmWindow::ActiveWindowsForTesting() {
+  auto& state = Slots(); base::AutoLock guard(state.lock); Prune(state, base::TimeTicks::Now());
+  size_t count = 0; for (const auto& entry : state.entries) if (entry) ++count; return count;
+}
+}  // namespace download
