+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_READ_SESSION_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_READ_SESSION_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/sequenced_task_runner_helpers.h"
+#include "components/download/public/common/download_export.h"
+
+namespace download {
+class DownloadFileCleanupState;
+class NativeDownloadLease;
+class NativeDownloadReadSessionTestPeer;
+
+// Origin-sequence owner. Actual file access and destruction stay on its file
+// sequence, and a separate close ACK holds the existing cleanup/lease gate.
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadReadSession {
+ public:
+  enum class Error { kNone, kUnavailable, kIo, kLimit, kClosed };
+  struct Metadata {
+    Error error = Error::kUnavailable;
+    uint64_t byte_length = 0;
+    std::string sha256;
+  };
+  struct Chunk {
+    Error error = Error::kUnavailable;
+    uint64_t offset = 0;
+    std::string bytes;
+    bool complete = false;
+  };
+  using ReadyCallback = base::OnceCallback<void(Metadata)>;
+  using ReadCallback = base::OnceCallback<void(Chunk)>;
+  static constexpr uint32_t kChunkBytes = 3072;
+  ~NativeDownloadReadSession();
+  NativeDownloadReadSession(const NativeDownloadReadSession&) = delete;
+  NativeDownloadReadSession& operator=(const NativeDownloadReadSession&) = delete;
+  bool Read(uint64_t offset, uint32_t maximum_bytes, ReadCallback done);
+  // At most one waiting close callback. Repeated no-callback close is harmless.
+  bool Close(base::OnceCallback<void(bool)> done = {});
+  bool closed() const { return closed_; }
+  bool busy() const { return busy_; }
+
+ private:
+  friend class NativeDownloadLease;
+  friend class NativeDownloadReadSessionTestPeer;
+  class IOState;
+  NativeDownloadReadSession(scoped_refptr<NativeDownloadLease> lease,
+      scoped_refptr<DownloadFileCleanupState> files, const base::FilePath& path,
+      uint64_t maximum_bytes, scoped_refptr<base::SequencedTaskRunner> runner,
+      scoped_refptr<base::SequencedTaskRunner> origin);
+  void Start(ReadyCallback done);
+  void DidOpen(ReadyCallback done, Metadata metadata);
+  void DidRead(ReadCallback done, Chunk chunk);
+  void DidClose(bool success);
+  base::WeakPtr<NativeDownloadReadSession> GetWeakPtr();
+  scoped_refptr<NativeDownloadLease> lease_;
+  scoped_refptr<DownloadFileCleanupState> files_;
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  std::unique_ptr<IOState, base::OnTaskRunnerDeleter> io_;
+  base::OnceCallback<void(bool)> close_ack_;
+  Metadata metadata_;
+  bool busy_ = true;
+  bool ready_ = false;
+  bool closing_ = false;
+  bool closed_ = false;
+  bool close_success_ = false;
+  bool close_posted_ = false;
+  base::OnceCallback<void(bool)> close_callback_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<NativeDownloadReadSession> weak_{this};
+};
+}  // namespace download
+#endif
