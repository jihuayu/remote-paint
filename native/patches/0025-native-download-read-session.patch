+#include "components/download/public/common/native_download_read_session.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/bind_post_task.h"
+#include "build/build_config.h"
+#include "components/download/public/common/download_file.h"
+#include "components/download/public/common/native_download_budget.h"
+#include "crypto/hash.h"
+#if BUILDFLAG(IS_POSIX)
+#include <fcntl.h>
+#include <sys/stat.h>
+#include "base/posix/eintr_wrapper.h"
+#endif
+
+namespace download {
+class NativeDownloadReadSession::IOState {
+ public:
+  IOState(const base::FilePath& path, uint64_t limit)
+      : path_(path), limit_(limit) {
+    DETACH_FROM_SEQUENCE(sequence_checker_);
+  }
+  ~IOState() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    file_.Close();
+  }
+  Metadata Open() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    Metadata result; result.error = Error::kIo;
+#if BUILDFLAG(IS_POSIX)
+    base::ScopedFD fd(HANDLE_EINTR(open(path_.value().c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK)));
+    base::stat_wrapper_t st{};
+    if (!fd.is_valid() || base::File::Fstat(fd.get(), &st) != 0 || !S_ISREG(st.st_mode)) return result;
+    file_ = base::File(std::move(fd));
+#else
+    // Source activation for other platforms requires an equivalent verified
+    // regular-file/no-follow/nonblocking ownership contract.
+    result.error = Error::kUnavailable; return result;
+#endif
+    const int64_t length = file_.GetLength();
+    if (length < 0) return result;
+    if (static_cast<uint64_t>(length) > limit_ || static_cast<uint64_t>(length) > NativeDownloadBudget::kFileBytes) {
+      result.error = Error::kLimit; return result;
+    }
+    if (!file_.GetInfo(&identity_) || identity_.is_directory) return result;
+    size_ = static_cast<uint64_t>(length);
+    crypto::hash::Hasher hash(crypto::hash::kSha256);
+    std::array<uint8_t, 8192> buffer;
+    for (uint64_t offset = 0; offset < size_;) {
+      const size_t count = static_cast<size_t>(std::min<uint64_t>(buffer.size(), size_ - offset));
+      auto span = base::span(buffer).first(count);
+      if (!file_.ReadAndCheck(static_cast<int64_t>(offset), span)) return result;
+      hash.Update(span); offset += count;
+    }
+    if (!Unchanged()) return result;
+    std::array<uint8_t, crypto::hash::kSha256Size> digest; hash.Finish(digest);
+    result.error = Error::kNone; result.byte_length = size_; result.sha256 = base::HexEncodeLower(digest);
+    return result;
+  }
+  Chunk Read(uint64_t offset, uint32_t maximum_bytes) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    Chunk result; result.error = Error::kIo; result.offset = offset;
+    if (!Unchanged() || offset > size_ || maximum_bytes == 0 || maximum_bytes > kChunkBytes) return result;
+    const size_t count = static_cast<size_t>(std::min<uint64_t>(maximum_bytes, size_ - offset));
+    result.bytes.resize(count);
+    if (count && !file_.ReadAndCheck(static_cast<int64_t>(offset), base::as_writable_byte_span(result.bytes))) {
+      result.bytes.clear(); return result;
+    }
+    if (!Unchanged()) { result.bytes.clear(); return result; }
+    result.error = Error::kNone; result.complete = offset + count == size_; return result;
+  }
+ private:
+  bool Unchanged() {
+    base::File::Info current;
+    return file_.IsValid() && file_.GetLength() == static_cast<int64_t>(size_) &&
+           file_.GetInfo(&current) && !current.is_directory && current.last_modified == identity_.last_modified;
+  }
+  const base::FilePath path_;
+  const uint64_t limit_;
+  base::File file_;
+  base::File::Info identity_;
+  uint64_t size_ = 0;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+NativeDownloadReadSession::NativeDownloadReadSession(
+    scoped_refptr<NativeDownloadLease> lease, scoped_refptr<DownloadFileCleanupState> files,
+    const base::FilePath& path, uint64_t maximum_bytes,
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    scoped_refptr<base::SequencedTaskRunner> origin)
+    : lease_(std::move(lease)), files_(std::move(files)), runner_(std::move(runner)),
+      io_(nullptr, base::OnTaskRunnerDeleter(runner_)) {
+  CHECK(runner_); CHECK(origin);
+  auto settled = base::BindOnce(
+      [](base::OnceCallback<void(bool)> complete, base::WeakPtr<NativeDownloadReadSession> self, bool success) {
+        std::move(complete).Run(success);
+        if (self) self->DidClose(success);
+      }, files_->HoldReadOwner(), weak_.GetWeakPtr());
+  close_ack_ = base::BindPostTask(std::move(origin), std::move(settled));
+  io_.reset(new IOState(path, maximum_bytes));
+}
+NativeDownloadReadSession::~NativeDownloadReadSession() { Close(); }
+base::WeakPtr<NativeDownloadReadSession> NativeDownloadReadSession::GetWeakPtr() { return weak_.GetWeakPtr(); }
+void NativeDownloadReadSession::Start(ReadyCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto completion = base::MakeRefCounted<base::RefCountedData<ReadyCallback>>(std::move(done));
+  const bool posted = runner_->PostTaskAndReplyWithResult(FROM_HERE,
+      base::BindOnce(&IOState::Open, base::Unretained(io_.get())),
+      base::BindOnce([](base::WeakPtr<NativeDownloadReadSession> self,
+                       scoped_refptr<base::RefCountedData<ReadyCallback>> completion, Metadata result) {
+        if (self) self->DidOpen(std::move(completion->data), std::move(result));
+      }, weak_.GetWeakPtr(), completion));
+  if (!posted) {
+    Close();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(
+        [](base::WeakPtr<NativeDownloadReadSession> self,
+           scoped_refptr<base::RefCountedData<ReadyCallback>> completion) {
+          if (self) self->DidOpen(std::move(completion->data), Metadata{});
+        }, weak_.GetWeakPtr(), completion));
+  }
+}
+void NativeDownloadReadSession::DidOpen(ReadyCallback done, Metadata metadata) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closing_ || lease_->retiring() || lease_->failed()) metadata = {Error::kClosed, 0, {}};
+  if (metadata.error == Error::kNone) { metadata_ = metadata; ready_ = true; }
+  else Close();
+  auto self = weak_.GetWeakPtr();
+  if (done) std::move(done).Run(std::move(metadata));
+  if (self) self->busy_ = false;
+}
+bool NativeDownloadReadSession::Read(uint64_t offset, uint32_t maximum_bytes, ReadCallback done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!done || !ready_ || busy_ || closing_ || lease_->retiring() || lease_->failed() ||
+      maximum_bytes == 0 || maximum_bytes > kChunkBytes || offset > metadata_.byte_length) return false;
+  busy_ = true;
+  const bool posted = runner_->PostTaskAndReplyWithResult(FROM_HERE,
+      base::BindOnce(&IOState::Read, base::Unretained(io_.get()), offset, maximum_bytes),
+      base::BindOnce(&NativeDownloadReadSession::DidRead, weak_.GetWeakPtr(), std::move(done)));
+  if (!posted) { busy_ = false; Close(); }
+  return posted;
+}
+void NativeDownloadReadSession::DidRead(ReadCallback done, Chunk chunk) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closing_ || lease_->retiring() || lease_->failed()) chunk = {Error::kClosed, chunk.offset, {}, false};
+  if (chunk.error != Error::kNone) Close();
+  auto self = weak_.GetWeakPtr();
+  if (done) std::move(done).Run(std::move(chunk));
+  if (self) self->busy_ = false;
+}
+bool NativeDownloadReadSession::Close(base::OnceCallback<void(bool)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed_) { if (done) std::move(done).Run(close_success_); return true; }
+  if (done && close_callback_) return false;
+  if (done) close_callback_ = std::move(done);
+  if (closing_) return close_posted_;
+  closing_ = true; ready_ = false;
+  // FIFO behind accepted open/read jobs. Destroy the complete owner (including
+  // its members) before posting the independent ACK. Rejected posting drops
+  // the ACK; the original sequence-safe deleter retains/falls back conservatively.
+  close_posted_ = runner_->PostTask(FROM_HERE, base::BindOnce(
+      [](std::unique_ptr<IOState, base::OnTaskRunnerDeleter> pending,
+         base::OnceCallback<void(bool)> ack) {
+        std::unique_ptr<IOState> state(pending.release());
+        state.reset();
+        std::move(ack).Run(true);
+      }, std::move(io_), std::move(close_ack_)));
+  if (!close_posted_) files_->RejectReadOwnerClose();
+  return close_posted_;
+}
+void NativeDownloadReadSession::DidClose(bool success) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  closed_ = true; close_success_ = success;
+  if (close_callback_) std::move(close_callback_).Run(success);
+}
