+// Origin-sequence state for actual file jobs. Retain this before item removal.
+// Zero pending jobs is not proof of item/network/retained-path retirement.
+class COMPONENTS_DOWNLOAD_EXPORT DownloadFileCleanupState
+    : public base::RefCountedThreadSafe<DownloadFileCleanupState> {
+ public:
+  struct Snapshot {
+    uint64_t pending;
+    bool failed;
+  };
+  DownloadFileCleanupState();
+  Snapshot GetSnapshot() const;
+  void Cancel(scoped_refptr<base::SequencedTaskRunner> runner,
+              std::unique_ptr<DownloadFile> file);
+  // Detach preserves the path, but still waits for the file object's destruction.
+  void Detach(scoped_refptr<base::SequencedTaskRunner> runner,
+              std::unique_ptr<DownloadFile> file);
+  void DeletePath(scoped_refptr<base::SequencedTaskRunner> runner,
+                  const base::FilePath& path,
+                  base::OnceCallback<void(bool)> done = {});
+
+ private:
+  friend class base::RefCountedThreadSafe<DownloadFileCleanupState>;
+  ~DownloadFileCleanupState();
+  void PostOwned(scoped_refptr<base::SequencedTaskRunner> runner,
+                 std::unique_ptr<DownloadFile> file, bool destroy);
+  void Post(scoped_refptr<base::SequencedTaskRunner> runner,
+            base::OnceCallback<bool()> task,
+            base::OnceCallback<void(bool)> done = {});
+  void Complete(bool success);
+  uint64_t pending_ = 0;
+  bool failed_ = false;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
 }  // namespace download
 
 #endif  // COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_FILE_H_
