+#include "base/functional/bind.h"
+#include "base/location.h"
+
 namespace download {
 
 DownloadFile::~DownloadFile() = default;
+
+bool DownloadFile::CancelAndReportDeletion() {
+  Cancel();
+  return false;
+}
+
+DownloadFileCleanupState::DownloadFileCleanupState() = default;
+DownloadFileCleanupState::~DownloadFileCleanupState() = default;
+
+DownloadFileCleanupState::Snapshot DownloadFileCleanupState::GetSnapshot() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return {pending_, failed_};
+}
+
+void DownloadFileCleanupState::Complete(bool success) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK_GT(pending_, 0u);
+  --pending_;
+  failed_ |= !success;
+}
+
+void DownloadFileCleanupState::Post(
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    base::OnceCallback<bool()> task,
+    base::OnceCallback<void(bool)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(runner);
+  CHECK_LT(pending_, std::numeric_limits<uint64_t>::max());
+  ++pending_;
+  auto completion = base::MakeRefCounted<
+      base::RefCountedData<base::OnceCallback<void(bool)>>>(std::move(done));
+  const bool posted = runner->PostTaskAndReplyWithResult(
+      FROM_HERE, std::move(task),
+      base::BindOnce(
+          [](scoped_refptr<DownloadFileCleanupState> state,
+             scoped_refptr<base::RefCountedData<
+                 base::OnceCallback<void(bool)>>> completion, bool success) {
+            state->Complete(success);
+            if (completion->data)
+              std::move(completion->data).Run(success);
+          }, base::WrapRefCounted(this), completion));
+  if (!posted) {
+    Complete(false);
+    if (completion->data)
+      std::move(completion->data).Run(false);
+  }
+  // A dropped reply leaves pending nonzero. Never fabricate shutdown success.
+}
+
+void DownloadFileCleanupState::PostOwned(
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    std::unique_ptr<DownloadFile> file, bool destroy) {
+  CHECK(file);
+  // Rejected posting must not destroy a sequence-bound file on the UI thread.
+  // OnTaskRunnerDeleter conservatively retains it if that sequence is shut down.
+  std::unique_ptr<DownloadFile, base::OnTaskRunnerDeleter> owned(
+      file.release(), base::OnTaskRunnerDeleter(runner));
+  Post(std::move(runner), base::BindOnce(
+      [](std::unique_ptr<DownloadFile, base::OnTaskRunnerDeleter> pending,
+         bool destroy) {
+        std::unique_ptr<DownloadFile> file(pending.release());
+        bool success = true;
+        if (destroy)
+          success = file->CancelAndReportDeletion();
+        else
+          file->Detach();
+        file.reset();  // Timers, streams and weak callbacks die before reply.
+        return success;
+      }, std::move(owned), destroy));
+}
+
+void DownloadFileCleanupState::Cancel(
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    std::unique_ptr<DownloadFile> file) {
+  PostOwned(std::move(runner), std::move(file), true);
+}
+
+void DownloadFileCleanupState::Detach(
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    std::unique_ptr<DownloadFile> file) {
+  PostOwned(std::move(runner), std::move(file), false);
+}
+
+void DownloadFileCleanupState::DeletePath(
+    scoped_refptr<base::SequencedTaskRunner> runner,
+    const base::FilePath& path, base::OnceCallback<void(bool)> done) {
+  Post(std::move(runner), base::BindOnce([](const base::FilePath& path) {
+#if BUILDFLAG(IS_ANDROID)
+    if (path.IsContentUri())
+      return false;  // No verified filesystem deletion for content URIs.
+#endif
+    // Legacy DeleteDownloadedFile reports directory skips as true. Native
+    // retirement must preserve and reject a directory instead of accepting it.
+    if (base::DirectoryExists(path))
+      return false;
+    return path.empty() || base::DeleteFile(path);
+  }, path), std::move(done));
+}
 
 bool DownloadFile::IsMemoryFile() {
   return false;
