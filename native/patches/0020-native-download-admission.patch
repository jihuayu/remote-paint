+++ b/components/download/public/common/native_download_budget.cc
@@ -0,0 +1,245 @@
+#include "components/download/public/common/native_download_budget.h"
+
+#include <atomic>
+#include <utility>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/notreached.h"
+#include "components/download/public/common/download_create_info.h"
+#include "components/download/public/common/download_file.h"
+#include "components/download/public/common/download_item_impl.h"
+#include "components/download/public/common/download_task_runner.h"
+#include "components/download/public/common/url_download_handler.h"
+
+namespace download {
+namespace {
+std::atomic<uint32_t> g_reserved{0};
+constexpr auto kActiveLifetime = base::Minutes(5);
+constexpr auto kTerminalRetention = base::Seconds(30);
+constexpr auto kPoll = base::Milliseconds(50);
+using RequestPhase = UrlDownloadHandlerCleanupState::Phase;
+bool IsEnabled() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch("remote-paint-token") &&
+         cmd->HasSwitch("remote-paint-download-budget-v1");
+}
+bool Reserve() {
+  uint32_t value = g_reserved.load();
+  while (value < NativeDownloadBudget::kMaxItems) {
+    if (g_reserved.compare_exchange_weak(value, value + 1)) return true;
+  }
+  return false;
+}
+}  // namespace
+
+uint32_t NativeDownloadBudget::ReservedItems() { return g_reserved.load(); }
+uint64_t NativeDownloadBudget::ReservedBytes() { return ReservedItems() * kFileBytes; }
+NativeDownloadBudget::NativeDownloadBudget(
+    base::RepeatingCallback<void(const std::string&)> done)
+    : enabled_(IsEnabled()), done_(std::move(done)) {}
+NativeDownloadBudget::~NativeDownloadBudget() { Shutdown(); }
+
+scoped_refptr<NativeDownloadLease> NativeDownloadBudget::Admit(
+    DownloadCreateInfo& info, base::OnceCallback<void(bool)>* cancel) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(enabled_);
+  if (!info.remote_paint_request_cleanup ||
+      info.remote_paint_request_cleanup->GetPhase() == RequestPhase::Failed)
+    return nullptr;
+  if (!info.is_new_download) {
+    for (auto& lease : slots_) {
+      if (lease && lease->guid() == info.guid && !lease->retiring() &&
+          !lease->failed()) {
+        if (lease->AddAttempt(info, cancel)) return lease;
+        lease->BeginRetire();
+        return nullptr;
+      }
+    }
+    return nullptr;
+  }
+  for (auto& slot : slots_) {
+    if (!slot && Reserve()) {
+      slot = base::WrapRefCounted(new NativeDownloadLease(base::BindRepeating(
+          &NativeDownloadBudget::Released, weak_.GetWeakPtr())));
+      slot->keepalive_ = slot;
+      CHECK(slot->AddAttempt(info, cancel));
+      return slot;
+    }
+  }
+  return nullptr;
+}
+void NativeDownloadBudget::Released(NativeDownloadLease* lease) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto& slot : slots_) {
+    if (slot.get() == lease) {
+      const std::string guid = lease->guid();
+      slot.reset();
+      if (done_ && !guid.empty()) done_.Run(guid);
+      return;
+    }
+  }
+  NOTREACHED();
+}
+void NativeDownloadBudget::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto& slot : slots_) if (slot) slot->BeginRetire();
+}
+
+NativeDownloadLease::NativeDownloadLease(
+    base::RepeatingCallback<void(NativeDownloadLease*)> done)
+    : done_(std::move(done)), deadline_(base::TimeTicks::Now() + kActiveLifetime) {}
+NativeDownloadLease::~NativeDownloadLease() = default;
+
+bool NativeDownloadLease::AddAttempt(
+    DownloadCreateInfo& info, base::OnceCallback<void(bool)>* cancel) {
+  if (retiring_ || failed_ || pending_creators_ || !info.remote_paint_request_cleanup) return false;
+  for (auto& request : requests_) {
+    if (request && request->GetPhase() == RequestPhase::Acknowledged) request.reset();
+    if (request && request->GetPhase() == RequestPhase::Failed) return false;
+  }
+  for (auto& request : requests_) {
+    if (!request) {
+      request = info.remote_paint_request_cleanup;
+      current_request_ = request;
+      cancel_ = base::MakeRefCounted<base::RefCountedData<
+          base::OnceCallback<void(bool)>>>(std::move(*cancel));
+      *cancel = base::BindOnce([](decltype(cancel_) cancel,
+                                  scoped_refptr<UrlDownloadHandlerCleanupState> request,
+                                  bool user) {
+        const auto phase = request->GetPhase();
+        if (cancel->data && (phase == RequestPhase::Active || phase == RequestPhase::Queued))
+          std::move(cancel->data).Run(user);
+        else
+          cancel->data.Reset();
+      }, cancel_, current_request_);
+      ++pending_creators_;
+      timer_.Start(FROM_HERE, deadline_ - base::TimeTicks::Now(),
+                   base::BindOnce(&NativeDownloadLease::Tick, this));
+      return true;
+    }
+  }
+  return false;
+}
+void NativeDownloadLease::Attach(DownloadItemImpl* item) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(!item_ && !had_item_);
+  item_ = item;
+  had_item_ = true;
+  files_ = item->GetRemotePaintFileCleanupState();
+  guid_ = item->GetGuid();
+  item->AddObserver(this);
+  CapturePaths();
+}
+void NativeDownloadLease::CreationDone(bool returned_item) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK_GT(pending_creators_, 0u);
+  --pending_creators_;
+  if (returned_item && !had_item_) { Fail(); return; }
+  if (!returned_item && !had_item_) {
+    metadata_retired_ = true;
+    retiring_ = true;
+  }
+  if (retiring_) Schedule();
+}
+void NativeDownloadLease::MetadataRetired() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  metadata_retired_ = true;
+  if (retiring_) Schedule();
+}
+void NativeDownloadLease::CapturePaths() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!item_) return;
+  for (const auto& path : {item_->GetFullPath(), item_->GetTargetFilePath()}) {
+    if (path.empty()) continue;
+    bool known = false;
+    for (const auto& old : paths_) if (old == path) known = true;
+    if (known) continue;
+    bool stored = false;
+    for (auto& old : paths_) if (old.empty()) { old = path; stored = true; break; }
+    if (!stored) { Fail(); return; }
+  }
+}
+void NativeDownloadLease::OnDownloadUpdated(DownloadItem* item) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CapturePaths();
+  if (!retiring_ && !terminal_ && item->IsDone()) {
+    terminal_ = true;
+    deadline_ = base::TimeTicks::Now() + kTerminalRetention;
+    timer_.Start(FROM_HERE, kTerminalRetention,
+                 base::BindOnce(&NativeDownloadLease::Tick, this));
+  }
+}
+void NativeDownloadLease::OnDownloadDestroyed(DownloadItem*) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CapturePaths();
+  item_ = nullptr;
+  retiring_ = true;
+  Schedule();  // Destruction notification itself is never metadata ACK.
+}
+void NativeDownloadLease::Fail() {
+  failed_ = true;
+  timer_.Stop();
+  // Keep the self-reference and global reservation until namespace retirement.
+}
+void NativeDownloadLease::BeginRetire() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_ || failed_) return;
+  retiring_ = true;
+  Tick();
+}
+void NativeDownloadLease::Schedule() {
+  if (!finished_ && !failed_)
+    timer_.Start(FROM_HERE, kPoll, base::BindOnce(&NativeDownloadLease::Tick, this));
+}
+void NativeDownloadLease::Tick() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (failed_ || finished_) return;
+  auto self = keepalive_;
+  retiring_ = true;
+  if (cancel_ && cancel_->data && current_request_) {
+    const auto phase = current_request_->GetPhase();
+    if (phase == RequestPhase::Active || phase == RequestPhase::Queued)
+      std::move(cancel_->data).Run(true);
+  }
+  if (pending_creators_) { Schedule(); return; }
+  if (item_ && !item_cancelled_) {
+    CapturePaths();
+    item_cancelled_ = true;
+    item_->Cancel(true);
+  }
+  if (had_item_ && !files_) { Fail(); return; }
+  if (files_ && !paths_queued_) {
+    paths_queued_ = true;
+    for (const auto& path : paths_)
+      if (!path.empty()) files_->DeletePath(GetDownloadTaskRunner(), path);
+  }
+  if (files_) {
+    const auto snapshot = files_->GetSnapshot();
+    if (snapshot.failed) { Fail(); return; }
+    if (snapshot.pending) { Schedule(); return; }
+  }
+  for (const auto& request : requests_) {
+    if (!request) continue;
+    const auto phase = request->GetPhase();
+    if (phase == RequestPhase::Failed) { Fail(); return; }
+    if (phase != RequestPhase::Acknowledged) { Schedule(); return; }
+  }
+  if (item_) {
+    item_->Remove();
+    Schedule();
+    return;
+  }
+  if (!metadata_retired_) { Schedule(); return; }
+  if (!failed_) Finish();
+}
+void NativeDownloadLease::Finish() {
+  auto self = keepalive_;
+  finished_ = true;
+  timer_.Stop();
+  CHECK_GT(g_reserved.fetch_sub(1), 0u);
+  done_.Run(this);
+  keepalive_.reset();
+}
+}  // namespace download
