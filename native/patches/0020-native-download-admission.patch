+// Bounded regular-download admission. Activation is staged behind the trusted
+// Native budget switch; remote network-service memory is outside this ledger.
+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_BUDGET_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_NATIVE_DOWNLOAD_BUDGET_H_
+
+#include <array>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/sequence_checker.h"
+#include "components/download/public/common/download_export.h"
+#include "components/download/public/common/download_item.h"
+
+namespace download {
+class DownloadFileCleanupState;
+class DownloadItemImpl;
+struct DownloadCreateInfo;
+class UrlDownloadHandlerCleanupState;
+class NativeDownloadBudget;
+
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadLease
+    : public base::RefCountedThreadSafe<NativeDownloadLease>,
+      public DownloadItem::Observer {
+ public:
+  void Attach(DownloadItemImpl* item);
+  void CreationDone(bool returned_item);
+  void MetadataRetired();  // Called only after the owner's erase has returned.
+  void BeginRetire();
+  const std::string& guid() const { return guid_; }
+  bool failed() const { return failed_; }
+  bool retiring() const { return retiring_; }
+  void OnDownloadUpdated(DownloadItem* item) override;
+  void OnDownloadDestroyed(DownloadItem* item) override;
+
+ private:
+  friend class NativeDownloadBudget;
+  friend class base::RefCountedThreadSafe<NativeDownloadLease>;
+  NativeDownloadLease(base::RepeatingCallback<void(NativeDownloadLease*)> done);
+  ~NativeDownloadLease() override;
+  bool AddAttempt(DownloadCreateInfo& info,
+                  base::OnceCallback<void(bool)>* cancel);
+  void CapturePaths();
+  void Tick();
+  void Schedule();
+  void Fail();
+  void Finish();
+  scoped_refptr<NativeDownloadLease> keepalive_;
+  base::RepeatingCallback<void(NativeDownloadLease*)> done_;
+  raw_ptr<DownloadItemImpl> item_ = nullptr;
+  scoped_refptr<DownloadFileCleanupState> files_;
+  std::array<scoped_refptr<UrlDownloadHandlerCleanupState>, 4> requests_;
+  scoped_refptr<UrlDownloadHandlerCleanupState> current_request_;
+  scoped_refptr<base::RefCountedData<base::OnceCallback<void(bool)>>> cancel_;
+  std::array<base::FilePath, 8> paths_;
+  std::string guid_;
+  base::OneShotTimer timer_;
+  base::TimeTicks deadline_;
+  size_t pending_creators_ = 0;
+  bool had_item_ = false;
+  bool terminal_ = false;
+  bool retiring_ = false;
+  bool failed_ = false;
+  bool item_cancelled_ = false;
+  bool paths_queued_ = false;
+  bool metadata_retired_ = false;
+  bool finished_ = false;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+class COMPONENTS_DOWNLOAD_EXPORT NativeDownloadBudget {
+ public:
+  static constexpr uint32_t kMaxItems = 4;
+  static constexpr uint64_t kFileBytes = 4 * 1024 * 1024;
+  static uint32_t ReservedItems();
+  static uint64_t ReservedBytes();
+  explicit NativeDownloadBudget(base::RepeatingCallback<void(const std::string&)> done);
+  ~NativeDownloadBudget();
+  bool enabled() const { return enabled_; }
+  scoped_refptr<NativeDownloadLease> Admit(
+      DownloadCreateInfo& info, base::OnceCallback<void(bool)>* cancel);
+  void Shutdown();
+ private:
+  void Released(NativeDownloadLease* lease);
+  const bool enabled_;
+  std::array<scoped_refptr<NativeDownloadLease>, kMaxItems> slots_;
+  base::RepeatingCallback<void(const std::string&)> done_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<NativeDownloadBudget> weak_{this};
+};
+}  // namespace download
+#endif
