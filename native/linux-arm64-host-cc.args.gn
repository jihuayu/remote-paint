target_os = "linux"
target_cpu = "arm64"
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
use_siso = false
use_thin_lto = false
# Avoid compiling a second Blink for the x64 context-snapshot generator.
# New contexts use normal initialization; the ordinary V8 snapshot stays enabled.
use_v8_context_snapshot = false
use_mold = false
enable_paint_preview = true
use_gtk = false
use_qt5 = false
use_qt6 = false
ozone_auto_platforms = false
ozone_platform_headless = true
ozone_platform_x11 = false
ozone_platform_wayland = false
# Optional same-revision Mac Clang service; Linux generators/linker stay local.
cc_wrapper = "/project/docker/host-cc-client.py"
