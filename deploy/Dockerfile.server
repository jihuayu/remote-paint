# The archive already includes Node. Keep the shipped image free of the larger
# Node build image used for CI; install only the Debian runtime dependencies.
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates libnss3 libglib2.0-0 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libx11-6 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
    libxkbcommon0 libdrm2 libgbm1 libpango-1.0-0 libasound2 libatspi2.0-0 \
    libudev1 libcups2 fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 remote-paint \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /tmp/remote-paint-home remote-paint
ARG PACKAGE_DIR=packages/required-extracted-package
ARG SOURCE_REVISION
COPY ${PACKAGE_DIR}/ /opt/remote-paint/
RUN cd /opt/remote-paint && sha256sum -c SHA256SUMS
LABEL org.opencontainers.image.title="Remote Paint private CDP server" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
ENV REMOTE_PAINT_CHROMIUM=/opt/remote-paint/browser/headless_shell \
    REMOTE_PAINT_BROKER=/opt/remote-paint/app/native/bin/remote-paint-broker \
    HOME=/tmp/remote-paint-home
WORKDIR /opt/remote-paint/app
USER remote-paint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/opt/remote-paint/node/bin/node", "/opt/remote-paint/app/service/container-health.mjs"]
ENTRYPOINT ["/opt/remote-paint/node/bin/node", "/opt/remote-paint/app/service/container-entry.mjs"]
