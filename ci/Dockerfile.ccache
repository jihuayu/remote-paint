# Isolated from the attested Chromium build image; adding ccache must not
# invalidate the existing Ninja output or installed-package fingerprint.
FROM remote-paint-ci
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ccache=4.8+really4.7.5-1 \
    && rm -rf /var/lib/apt/lists/* \
    && ccache --version | head -n 1 | grep -Fx 'ccache version 4.7.5'
